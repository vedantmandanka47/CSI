{
  "name": "csi-gcet-sb",
  "version": "0.1.0",
  "private": true,
  "description": "CSI GCET Student Branch Official Web Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"api,web\" -c \"blue,green\" \"npm run dev --workspace=apps/api\" \"npm run dev --workspace=apps/web\"",
    "build": "npm run build --workspaces --if-present",
    "start": "concurrently -k -p \"[{name}]\" -n \"api,web\" -c \"blue,green\" \"npm run start --workspace=apps/api\" \"npm run start --workspace=apps/web\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "db:reset:dev": "tsx scripts/db-reset-dev.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "gen:secrets": "node scripts/gen-secrets.mjs",
    "check:colors": "node scripts/check-hardcoded-colors.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:content": "node scripts/check-content.mjs",
    "audit:deps": "npm audit --omit=dev"
  },
  "devDependencies": {
    "@eslint/js": "9.22.0",
    "concurrently": "9.1.2",
    "eslint": "9.22.0",
    "eslint-config-prettier": "10.1.1",
    "prettier": "3.5.3",
    "tslib": "2.8.1",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "typescript-eslint": "8.26.0"
  }
}
