datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATION_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique @db.VarChar(50)
  name            String           @db.VarChar(100)
  description     String           @db.Text
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  roleAssignments RoleAssignment[]

  @@map("roles")
}

model Committee {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique @db.VarChar(50)
  name            String           @db.VarChar(100)
  description     String           @db.Text
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  roleAssignments RoleAssignment[]
  tasks           Task[]
  checklists      Checklist[]
  checklistRuns   ChecklistRun[]
  assets          CommitteeAsset[]

  @@map("committees")
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  enrollmentNo    String?          @map("enrollment_no") @db.VarChar(50)
  name            String           @db.VarChar(100)
  email           String           @unique @db.Citext
  phone           String?          @db.VarChar(20)
  branch          String?          @db.VarChar(50)
  year            Int?
  photo           String?          @db.VarChar(255)
  status          String           @default("pending") @db.VarChar(20)
  passwordHash    String           @map("password_hash") @db.VarChar(255)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  roleAssignments RoleAssignment[]
  sessions            Session[]
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  registrations             Registration[]
  createdAttendanceSessions AttendanceSession[]  @relation("CreatedAttendanceSessions")
  markedAttendanceRecords   AttendanceRecord[]   @relation("MarkedAttendanceRecords")
  createdCertificateBatches CertificateBatch[]   @relation("CreatedCertificateBatches")
  certificates              Certificate[]
  revokedCertificates       Certificate[]        @relation("RevokedCertificates")
  passports                 Passport[]           @relation("UserPassports")
  revokedPassports          Passport[]           @relation("RevokedPassports")
  assignedTasks             Task[]               @relation("AssignedTasks")
  createdTasks              Task[]               @relation("CreatedTasks")
  createdChecklists         Checklist[]          @relation("CreatedChecklists")
  completedChecklistItems   ChecklistItem[]      @relation("CompletedChecklistItems")
  assignedChecklistItems    ChecklistItem[]      @relation("AssignedChecklistItems")
  createdChecklistRuns      ChecklistRun[]       @relation("CreatedChecklistRuns")
  signedOffChecklistRuns    ChecklistRun[]       @relation("SignedOffChecklistRuns")
  uploadedAssets            CommitteeAsset[]     @relation("UploadedAssets")
  reviewedAssets            CommitteeAsset[]     @relation("ReviewedAssets")
  createdAcademicTerms      AcademicTerm[]       @relation("CreatedAcademicTerms")
  capturedSnapshots         TermSnapshot[]       @relation("CapturedSnapshots")
  executedRollovers         TermRollover[]       @relation("ExecutedRollovers")

  @@map("users")
}

model RoleAssignment {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  roleId      String     @map("role_id") @db.Uuid
  committeeId String?    @map("committee_id") @db.Uuid
  termStart   DateTime   @default(now()) @map("term_start") @db.Timestamptz(6)
  termEnd     DateTime?  @map("term_end") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  committee   Committee? @relation(fields: [committeeId], references: [id], onDelete: SetNull)

  @@map("role_assignments")
}

model RosterEntry {
  id           String   @id @default(uuid()) @db.Uuid
  academicYear String   @map("academic_year") @db.VarChar(20)
  enrollmentNo String   @map("enrollment_no") @db.VarChar(50)
  name         String   @db.VarChar(100)
  branch       String   @db.VarChar(50)
  year         Int
  importedAt   DateTime @default(now()) @map("imported_at") @db.Timestamptz(6)

  @@unique([academicYear, enrollmentNo], name: "academic_enrollment_unique")
  @@map("roster_entries")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  targetType String?  @map("target_type") @db.VarChar(100)
  targetId   String?  @map("target_id") @db.Uuid
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  ip         String?  @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc), action])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("audit_log")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  userAgent String?   @map("user_agent") @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}


model Venue {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(100)
  description     String?  @db.Text
  building        String   @default("Main Building") @db.VarChar(100)
  roomNumber      String?  @map("room_number") @db.VarChar(50)
  capacity        Int
  mapUrl          String?  @map("map_url") @db.VarChar(255)
  contact         String?  @db.VarChar(100)
  notes           String?  @db.Text
  avCapabilities  String[] @default([]) @map("av_capabilities")
  isAvailable     Boolean  @default(true) @map("is_available")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  events          Event[]

  @@map("venues")
}

model Event {
  id                    String         @id @default(uuid()) @db.Uuid
  slug                  String         @unique @db.VarChar(100)
  title                 String         @db.VarChar(200)
  description           String         @db.Text
  category              String         @default("workshop") @db.VarChar(50)
  venueId               String?        @map("venue_id") @db.Uuid
  startsAt              DateTime       @map("starts_at") @db.Timestamptz(6)
  endsAt                DateTime       @map("ends_at") @db.Timestamptz(6)
  registrationOpensAt   DateTime?      @map("registration_opens_at") @db.Timestamptz(6)
  registrationClosesAt  DateTime?      @map("registration_closes_at") @db.Timestamptz(6)
  capacity              Int            @default(50)
  state                 String         @default("draft") @db.VarChar(50)
  posterUrl             String?        @map("poster_url") @db.VarChar(255)
  certificateTemplateId String?        @map("certificate_template_id") @db.Uuid
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  venue                 Venue?         @relation(fields: [venueId], references: [id], onDelete: SetNull)
  registrations         Registration[]
  guests                EventGuest[]
  attendanceSessions    AttendanceSession[]
  attendanceRecords     AttendanceRecord[]
  certificateBatches    CertificateBatch[]
  certificates          Certificate[]
  tasks                 Task[]
  checklists            Checklist[]
  checklistRuns         ChecklistRun[]
  assets                CommitteeAsset[]

  @@index([state, startsAt])
  @@index([category])
  @@index([slug])
  @@map("events")
}

model Registration {
  id           String    @id @default(uuid()) @db.Uuid
  eventId      String    @map("event_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  status       String    @default("registered") @db.VarChar(50)
  registeredAt DateTime  @default(now()) @map("registered_at") @db.Timestamptz(6)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)

  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId], name: "event_user_unique")
  @@index([eventId, status])
  @@index([userId])
  @@map("registrations")
}

model EventGuest {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  name      String   @db.VarChar(100)
  email     String   @db.Citext
  college   String   @db.VarChar(150)
  phone     String   @db.VarChar(20)
  consentAt DateTime @default(now()) @map("consent_at") @db.Timestamptz(6)
  status    String   @default("registered") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email], name: "event_guest_unique")
  @@index([eventId, status])
  @@map("event_guests")
}


model DriveWindow {
  id        String   @id @default(uuid()) @db.Uuid
  type      String   @unique @db.VarChar(50)
  opensAt   DateTime @map("opens_at") @db.Timestamptz(6)
  closesAt  DateTime @map("closes_at") @db.Timestamptz(6)
  isOpen    Boolean  @default(true) @map("is_open")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([type, isOpen])
  @@map("drive_windows")
}

model AttendanceSession {
  id              String             @id @default(uuid()) @db.Uuid
  eventId         String             @map("event_id") @db.Uuid
  name            String             @db.VarChar(100)
  audience        String             @default("all") @db.VarChar(50)
  startsAt        DateTime           @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime           @map("ends_at") @db.Timestamptz(6)
  isOpen          Boolean            @default(true) @map("is_open")
  totpSecret      String             @map("totp_secret") @db.VarChar(128)
  totpStepSeconds Int                @default(30) @map("totp_step_seconds")
  createdById     String             @map("created_by_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  event           Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy       User               @relation("CreatedAttendanceSessions", fields: [createdById], references: [id], onDelete: Restrict)
  records         AttendanceRecord[]

  @@index([eventId, isOpen])
  @@index([createdById])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id              String            @id @default(uuid()) @db.Uuid
  sessionId       String            @map("session_id") @db.Uuid
  eventId         String            @map("event_id") @db.Uuid
  subjectType     String            @default("member") @map("subject_type") @db.VarChar(20)
  subjectId       String            @map("subject_id") @db.Uuid
  method          String            @default("qr_scan") @db.VarChar(20)
  status          String            @default("verified") @db.VarChar(20)
  clientUuid      String            @unique @map("client_uuid") @db.VarChar(64)
  clientMarkedAt  DateTime          @default(now()) @map("client_marked_at") @db.Timestamptz(6)
  verifiedAt      DateTime          @default(now()) @map("verified_at") @db.Timestamptz(6)
  markedById      String            @map("marked_by_id") @db.Uuid
  notes           String?           @db.Text
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  session         AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  event           Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  markedBy        User              @relation("MarkedAttendanceRecords", fields: [markedById], references: [id], onDelete: Restrict)

  @@unique([sessionId, subjectType, subjectId], name: "session_subject_unique")
  @@index([sessionId, status])
  @@index([eventId])
  @@index([subjectId])
  @@index([markedById])
  @@map("attendance_records")
}

model IdempotencyKey {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique @db.VarChar(64)
  userId      String?   @map("user_id") @db.Uuid
  route       String    @db.VarChar(200)
  requestHash String    @map("request_hash") @db.VarChar(64)
  response    Json?
  statusCode  Int?      @map("status_code")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)

  @@index([key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model CertificateBatch {
  id              String        @id @default(uuid()) @db.Uuid
  eventId         String        @map("event_id") @db.Uuid
  templateId      String        @map("template_id") @db.VarChar(100)
  templateConfig  Json          @map("template_config")
  certificateType String        @map("certificate_type") @db.VarChar(50)
  status          String        @default("pending") @db.VarChar(50)
  totalCount      Int           @default(0) @map("total_count")
  successCount    Int           @default(0) @map("success_count")
  failedCount     Int           @default(0) @map("failed_count")
  createdById     String        @map("created_by_id") @db.Uuid
  failureReason   String?       @map("failure_reason") @db.Text
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt     DateTime?     @map("completed_at") @db.Timestamptz(6)

  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy       User          @relation("CreatedCertificateBatches", fields: [createdById], references: [id], onDelete: Restrict)
  certificates    Certificate[]

  @@index([eventId, status])
  @@index([createdById])
  @@map("certificate_batches")
}

model Certificate {
  id                String            @id @default(uuid()) @db.Uuid
  batchId           String?           @map("batch_id") @db.Uuid
  eventId           String            @map("event_id") @db.Uuid
  recipientType     String            @default("member") @map("recipient_type") @db.VarChar(20)
  recipientId       String?           @map("recipient_id") @db.Uuid
  recipientEmail    String            @map("recipient_email") @db.Citext
  recipientName     String            @map("recipient_name") @db.VarChar(150)
  certificateType   String            @default("participation") @map("certificate_type") @db.VarChar(50)
  certificateNumber String            @unique @map("certificate_number") @db.VarChar(100)
  issueDate         String            @map("issue_date") @db.VarChar(50)
  achievement       String?           @db.VarChar(200)
  metadata          Json?
  status            String            @default("pending") @db.VarChar(50)
  storagePath       String?           @map("storage_path") @db.VarChar(255)
  fileHash          String?           @map("file_hash") @db.VarChar(64)
  fileSizeBytes     Int?              @map("file_size_bytes")
  errorReason       String?           @map("error_reason") @db.Text
  retryCount        Int               @default(0) @map("retry_count")
  verificationCodeHash String?         @unique @map("verification_code_hash") @db.VarChar(64)
  revokedAt         DateTime?         @map("revoked_at") @db.Timestamptz(6)
  revocationReason  String?           @map("revocation_reason") @db.Text
  revokedById       String?           @map("revoked_by_id") @db.Uuid
  issuedAt          DateTime?         @map("issued_at") @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  batch             CertificateBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  event             Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipient         User?             @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  revokedBy         User?             @relation("RevokedCertificates", fields: [revokedById], references: [id], onDelete: SetNull)

  @@unique([eventId, recipientEmail, certificateType], name: "event_email_cert_type_unique")
  @@index([eventId, status])
  @@index([status])
  @@index([recipientId])
  @@index([batchId, status])
  @@index([revokedById])
  @@map("certificates")
}

model Passport {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  passportNumber       String    @unique @map("passport_number") @db.VarChar(100)
  status               String    @default("active") @db.VarChar(50)
  fileHash             String?   @map("file_hash") @db.VarChar(64)
  fileSizeBytes        Int?      @map("file_size_bytes")
  storagePath          String?   @map("storage_path") @db.VarChar(255)
  verificationCodeHash String    @unique @map("verification_code_hash") @db.VarChar(64)
  summaryJson          Json?     @map("summary_json")
  generatedAt          DateTime  @default(now()) @map("generated_at") @db.Timestamptz(6)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(6)
  revocationReason     String?   @map("revocation_reason") @db.Text
  revokedById          String?   @map("revoked_by_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                 User      @relation("UserPassports", fields: [userId], references: [id], onDelete: Cascade)
  revokedBy            User?     @relation("RevokedPassports", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId, generatedAt(sort: Desc)])
  @@index([status])
  @@index([revokedById])
  @@map("passports")
}

model Task {
  id           String           @id @default(uuid()) @db.Uuid
  committeeId  String           @map("committee_id") @db.Uuid
  eventId      String?          @map("event_id") @db.Uuid
  title        String           @db.VarChar(255)
  description  String?          @db.Text
  status       String           @default("todo") @db.VarChar(50)
  priority     String           @default("medium") @db.VarChar(50)
  dueDate      DateTime?        @map("due_date") @db.Timestamptz(6)
  assignedToId String?          @map("assigned_to_id") @db.Uuid
  createdById  String           @map("created_by_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  committee    Committee        @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  event        Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  assignedTo   User?            @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy    User             @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Restrict)
  checklists   Checklist[]
  assets       CommitteeAsset[]

  @@index([committeeId])
  @@index([assignedToId])
  @@index([status])
  @@index([eventId])
  @@map("tasks")
}

model Checklist {
  id          String          @id @default(uuid()) @db.Uuid
  committeeId String          @map("committee_id") @db.Uuid
  eventId     String?         @map("event_id") @db.Uuid
  taskId      String?         @map("task_id") @db.Uuid
  title       String          @db.VarChar(255)
  description String?         @db.Text
  isTemplate  Boolean         @default(false) @map("is_template")
  createdById String          @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  committee   Committee       @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  event       Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  task        Task?           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy   User            @relation("CreatedChecklists", fields: [createdById], references: [id], onDelete: Restrict)
  items       ChecklistItem[]
  runs        ChecklistRun[]

  @@index([committeeId])
  @@index([eventId])
  @@index([taskId])
  @@map("checklists")
}

model ChecklistItem {
  id            String    @id @default(uuid()) @db.Uuid
  checklistId   String    @map("checklist_id") @db.Uuid
  title         String    @db.VarChar(255)
  description   String?   @db.Text
  isCompleted   Boolean   @default(false) @map("is_completed")
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)
  completedById String?   @map("completed_by_id") @db.Uuid
  assignedToId  String?   @map("assigned_to_id") @db.Uuid
  orderIndex    Int       @default(0) @map("order_index")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  checklist     Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  completedBy   User?     @relation("CompletedChecklistItems", fields: [completedById], references: [id], onDelete: SetNull)
  assignedTo    User?     @relation("AssignedChecklistItems", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([checklistId, orderIndex])
  @@index([assignedToId])
  @@map("checklist_items")
}

model ChecklistRun {
  id             String    @id @default(uuid()) @db.Uuid
  checklistId    String    @map("checklist_id") @db.Uuid
  committeeId    String    @map("committee_id") @db.Uuid
  eventId        String?   @map("event_id") @db.Uuid
  status         String    @default("in_progress") @db.VarChar(50)
  signOffNotes   String?   @map("sign_off_notes") @db.Text
  signedOffAt    DateTime? @map("signed_off_at") @db.Timestamptz(6)
  signedOffById  String?   @map("signed_off_by_id") @db.Uuid
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  checklist      Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  committee      Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  event          Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  signedOffBy    User?     @relation("SignedOffChecklistRuns", fields: [signedOffById], references: [id], onDelete: SetNull)
  createdBy      User      @relation("CreatedChecklistRuns", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([checklistId])
  @@index([committeeId])
  @@index([eventId])
  @@index([status])
  @@map("checklist_runs")
}

model CommitteeAsset {
  id            String    @id @default(uuid()) @db.Uuid
  committeeId   String    @map("committee_id") @db.Uuid
  eventId       String?   @map("event_id") @db.Uuid
  taskId        String?   @map("task_id") @db.Uuid
  title         String    @db.VarChar(255)
  category      String    @default("other") @db.VarChar(50)
  fileName      String    @map("file_name") @db.VarChar(255)
  storagePath   String    @map("storage_path") @db.VarChar(500)
  fileSizeBytes Int       @map("file_size_bytes")
  mimeType      String    @map("mime_type") @db.VarChar(100)
  fileHash      String    @map("file_hash") @db.VarChar(64)
  status        String    @default("draft") @db.VarChar(50)
  reviewNotes   String?   @map("review_notes") @db.Text
  reviewedById  String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt    DateTime? @map("reviewed_at") @db.Timestamptz(6)
  uploadedById  String    @map("uploaded_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  committee     Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  event         Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  task          Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  reviewedBy    User?     @relation("ReviewedAssets", fields: [reviewedById], references: [id], onDelete: SetNull)
  uploadedBy    User      @relation("UploadedAssets", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([committeeId])
  @@index([eventId])
  @@index([taskId])
  @@index([status])
  @@index([uploadedById])
  @@map("committee_assets")
}

model AcademicTerm {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @db.VarChar(100)
  code          String         @unique @db.VarChar(50)
  startDate     DateTime       @map("start_date") @db.Timestamptz(6)
  endDate       DateTime       @map("end_date") @db.Timestamptz(6)
  status        String         @default("draft") @db.VarChar(50)
  isCurrent     Boolean        @default(false) @map("is_current")
  archivedAt    DateTime?      @map("archived_at") @db.Timestamptz(6)
  createdById   String         @map("created_by_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy     User           @relation("CreatedAcademicTerms", fields: [createdById], references: [id], onDelete: Restrict)
  rolloversFrom TermRollover[] @relation("RolloverFromTerm")
  rolloversTo   TermRollover[] @relation("RolloverToTerm")
  snapshots     TermSnapshot[]

  @@index([isCurrent])
  @@index([status])
  @@index([startDate, endDate])
  @@map("academic_terms")
}

model TermSnapshot {
  id           String       @id @default(uuid()) @db.Uuid
  termId       String       @map("term_id") @db.Uuid
  termCode     String       @map("term_code") @db.VarChar(50)
  termName     String       @map("term_name") @db.VarChar(100)
  snapshotJson Json         @map("snapshot_json")
  capturedAt   DateTime     @default(now()) @map("captured_at") @db.Timestamptz(6)
  capturedById String       @map("captured_by_id") @db.Uuid

  term         AcademicTerm @relation(fields: [termId], references: [id], onDelete: Cascade)
  capturedBy   User         @relation("CapturedSnapshots", fields: [capturedById], references: [id], onDelete: Restrict)

  @@index([termId])
  @@map("term_snapshots")
}

model TermRollover {
  id           String        @id @default(uuid()) @db.Uuid
  fromTermId   String?       @map("from_term_id") @db.Uuid
  toTermId     String        @map("to_term_id") @db.Uuid
  executedById String        @map("executed_by_id") @db.Uuid
  executedAt   DateTime      @default(now()) @map("executed_at") @db.Timestamptz(6)
  status       String        @default("completed") @db.VarChar(50)
  summaryJson  Json          @map("summary_json")
  notes        String?       @db.Text

  fromTerm     AcademicTerm? @relation("RolloverFromTerm", fields: [fromTermId], references: [id], onDelete: SetNull)
  toTerm       AcademicTerm  @relation("RolloverToTerm", fields: [toTermId], references: [id], onDelete: Restrict)
  executedBy   User          @relation("ExecutedRollovers", fields: [executedById], references: [id], onDelete: Restrict)

  @@index([fromTermId])
  @@index([toTermId])
  @@index([executedAt(sort: Desc)])
  @@map("term_rollovers")
}

