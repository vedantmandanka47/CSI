# Environment Configuration
NODE_ENV=development
API_PORT=4000
PUBLIC_APP_URL=http://localhost:3000
TRUST_PROXY_HOPS=1

# Database Configuration (Postgres local install on port 5432)
DATABASE_URL=postgresql://csi_app:choose_password@localhost:5432/csi_gcet_dev
MIGRATION_DATABASE_URL=postgresql://csi_migrator:choose_password@localhost:5432/csi_gcet_dev

# Security & Secrets (Minimum 32 random bytes/chars)
SESSION_SECRET=dev_session_secret_replace_in_production_32bytes
CSRF_SECRET=dev_csrf_secret_replace_in_production_32bytes_long
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ID Card QR Signing (Ed25519)
QR_SIGNING_PRIVATE_KEY=dev_ed25519_private_key_placeholder
QR_SIGNING_PUBLIC_KEY=dev_ed25519_public_key_placeholder
QR_KEY_ID=csi-qr-key-v1

# Attendance Settings
ATTENDANCE_CODE_STEP_SECONDS=30

# Storage Driver (local or s3)
STORAGE_DRIVER=local

# Mail Configuration
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=dev
MAIL_PASS=dev
MAIL_FROM=no-reply@csigcet.org

# Monitoring (optional in development)
SENTRY_DSN=

